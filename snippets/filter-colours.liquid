<ul class="filter-list" role="list">
  {%- for value in filter.values -%}
    {%- assign is_active   = value.active -%}
    {%- assign is_disabled = false -%}
    {%- unless is_active -%}{%- if value.count == 0 -%}{%- assign is_disabled = true -%}{%- endif -%}{%- endunless -%}
    {%- if is_disabled -%}{%- continue -%}{%- endif -%}
    <li>
      <label class="filter-opt{% if is_active %} filter-opt--active{% endif %}{% if is_disabled %} filter-opt--disabled{% endif %}">
        <input
          type="checkbox"
          class="filter-checkbox sr-only"
          {% if is_active %}checked{% endif %}
          {% if is_disabled %}disabled{% endif %}
          data-url-add="{{ value.url_to_add }}"
          data-url-remove="{{ value.url_to_remove }}"
        >
        <span class="filter-opt__label">{{ value.label | downcase | capitalize }}</span>
        {%- if value.count > 0 -%}<span class="filter-opt__count">({{ value.count }})</span>{%- endif -%}
      </label>
    </li>
  {%- endfor -%}
</ul>
