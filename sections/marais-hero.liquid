<section class="mh-hero"{% unless section.settings.gender == 'both' %} data-gender="{{ section.settings.gender }}"{% endunless %}>
  {%- if section.settings.bg_image != blank -%}
    <div class="mh-hero__bg" style="position:absolute;inset:0;">
      <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" alt="" loading="eager" style="width:100%;height:100%;object-fit:cover;">
    </div>
  {%- else -%}
    <div class="mh-hero__bg"></div>
  {%- endif -%}

  <div class="mh-hero__visual">
    <div class="mh-hero__float">
      {%- if section.settings.visual_image != blank -%}
        <img
          src="{{ section.settings.visual_image | image_url: width: 700 }}"
          alt="{{ section.settings.heading_line1 }}"
          loading="eager"
          width="700"
          style="max-height:85vh;max-width:100%;object-fit:contain;"
        >
      {%- else -%}
        <svg viewBox="0 0 340 500" width="320" fill="none" style="filter:drop-shadow(0 24px 64px rgba(0,0,0,0.55))">
          <g transform="translate(70,70)">
            <path d="M100 18C65 18 28 46 16 98L4 205C4 224 15 234 36 234L164 234C185 234 196 224 196 205L184 98C172 46 135 18 100 18Z" fill="url(#mhbg1)"/>
            <path d="M4 118Q100 113 196 118" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" fill="none"/>
            <path d="M2 142Q100 137 198 142" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" fill="none"/>
            <path d="M0 166Q100 161 200 166" stroke="rgba(255,255,255,0.1)" stroke-width="1.5" fill="none"/>
            <path d="M100 18L100 234" stroke="rgba(255,255,255,0.2)" stroke-width="2" stroke-dasharray="5 5"/>
            <path d="M78 18C78 4 122 4 122 18" fill="#243555"/>
            <path d="M16 98C-12 86-20 116-12 174L4 198L16 178L10 98Z" fill="url(#mhsl1)"/>
            <path d="M184 98C212 86 220 116 212 174L196 198L184 178L190 98Z" fill="url(#mhsl1)"/>
            <rect x="152" y="108" width="26" height="17" rx="2" fill="rgba(201,168,76,0.85)"/>
            <text x="165" y="120" font-family="serif" font-size="9" fill="#1a0f00" text-anchor="middle" font-weight="bold">M</text>
          </g>
          <defs>
            <linearGradient id="mhbg1" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#1a2a4a"/><stop offset="50%" stop-color="#0d1a35"/><stop offset="100%" stop-color="#081020"/></linearGradient>
            <linearGradient id="mhsl1" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#162240"/><stop offset="100%" stop-color="#060e1c"/></linearGradient>
          </defs>
        </svg>
      {%- endif -%}
    </div>
  </div>

  <div class="mh-hero__content">
    {%- if section.settings.badge != blank -%}
      <span class="mh-hero__badge">{{ section.settings.badge }}</span>
    {%- endif -%}
    <h1 class="mh-hero__h1">
      {{ section.settings.heading_line1 }}<br>
      {{ section.settings.heading_line2 }}<br>
      <em>{{ section.settings.heading_italic }}</em>
    </h1>
    {%- if section.settings.subtext != blank -%}
      <p class="mh-hero__sub">{{ section.settings.subtext }}</p>
    {%- endif -%}
    <div class="mh-hero__cta">
      {%- if section.settings.cta1_label != blank -%}
        <a href="{{ section.settings.cta1_link }}" class="mh-btn-w">{{ section.settings.cta1_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_link }}" class="mh-btn-o">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="mh-hero__scroll">
    <span>Scroll</span>
    <div class="mh-hero__scroll-line"></div>
  </div>
</section>

<script>
(function () {
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('mh-vis'); });
  }, { threshold: 0.05 });
  document.querySelectorAll('.mh-story .mh-fu, .mh-nl .mh-fu').forEach(function (el) { io.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background image", "info": "Overrides the dark gradient when set." },
    { "type": "image_picker", "id": "visual_image", "label": "Right-side visual image", "info": "Product or campaign image. Uses an SVG placeholder if blank." },
    { "type": "text", "id": "badge", "label": "Badge text", "default": "Fall / Winter 2025 — New Arrivals" },
    { "type": "text", "id": "heading_line1", "label": "Heading line 1", "default": "The" },
    { "type": "text", "id": "heading_line2", "label": "Heading line 2", "default": "Luxury" },
    { "type": "text", "id": "heading_italic", "label": "Heading italic line", "default": "Edit" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Melbourne's premier multi-brand luxury boutique. Maison Margiela, Rick Owens, Loewe, Balenciaga and more — curated with intention." },
    { "type": "text", "id": "cta1_label", "label": "CTA 1 label", "default": "Shop Women" },
    { "type": "url", "id": "cta1_link", "label": "CTA 1 link" },
    { "type": "text", "id": "cta2_label", "label": "CTA 2 label", "default": "Shop Men" },
    { "type": "url", "id": "cta2_link", "label": "CTA 2 link" },
    { "type": "select", "id": "gender", "label": "Show for", "options": [{ "value": "both", "label": "Everyone" }, { "value": "women", "label": "Women only" }, { "value": "men", "label": "Men only" }], "default": "both" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
