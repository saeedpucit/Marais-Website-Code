{%- assign current_letter = '' -%}
{%- assign sorted_blocks = section.blocks | sort: 'settings.letter' -%}

<div class="mh-brands-full">
  {%- for block in sorted_blocks -%}
    {%- assign letter = block.settings.letter | upcase | strip -%}
    {%- if letter == '' -%}{%- assign letter = block.settings.name | upcase | slice: 0, 1 -%}{%- endif -%}

    {%- if letter != current_letter -%}
      {%- unless forloop.first -%}
          </div><!-- /.mh-brands-full__list -->
        </div><!-- /.mh-brands-full__group -->
      {%- endunless -%}
      <div class="mh-brands-full__group">
        <div class="mh-brands-full__letter" aria-hidden="true">{{ letter }}</div>
        <div class="mh-brands-full__list">
      {%- assign current_letter = letter -%}
    {%- endif -%}

    <a
      href="{{ block.settings.link | default: '/collections/all' }}"
      class="mh-brands-full__row"
      data-name="{{ block.settings.name | downcase | escape }}"
      {{ block.shopify_attributes }}
    >
      <span class="mh-brands-full__name">{{ block.settings.name }}</span>
      {%- if block.settings.tagline != blank -%}
        <span class="mh-brands-full__tagline">{{ block.settings.tagline }}</span>
      {%- endif -%}
      {%- if block.settings.gender != blank -%}
        <span class="mh-brands-full__gender">{{ block.settings.gender }}</span>
      {%- endif -%}
      <span class="mh-brands-full__shop">Shop &rarr;</span>
    </a>

    {%- if forloop.last -%}
        </div><!-- /.mh-brands-full__list -->
      </div><!-- /.mh-brands-full__group -->
    {%- endif -%}

  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Brands A–Z",
  "tag": "section",
  "max_blocks": 50,
  "blocks": [
    {
      "type": "brand",
