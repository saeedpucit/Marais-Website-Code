<div class="mh-story">
  <div class="mh-story__vis">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1000 }}"
        alt="{{ section.settings.heading | escape }}"
        loading="lazy"
        style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;"
      >
    {%- else -%}
      <svg viewBox="0 0 380 380" width="280" fill="none" opacity="0.55">
        <path d="M0 340 L80 140 L130 210 L190 68 L250 190 L300 110 L350 170 L380 340Z" fill="rgba(255,255,255,0.04)" stroke="rgba(201,168,76,0.25)" stroke-width="1"/>
        <path d="M182 68 L190 68 L198 84 L194 90 L186 90 L180 84Z" fill="rgba(255,255,255,0.35)"/>
        <path d="M294 110 L302 110 L308 124 L304 128 L296 128 L290 122Z" fill="rgba(255,255,255,0.25)"/>
        <circle cx="310" cy="42" r="2" fill="rgba(201,168,76,0.7)"/>
        <circle cx="60" cy="50" r="1.5" fill="rgba(255,255,255,0.5)"/>
        <circle cx="240" cy="15" r="1.5" fill="rgba(255,255,255,0.4)"/>
      </svg>
    {%- endif -%}
  </div>
  <div class="mh-story__body">
    {%- if section.settings.year != blank -%}
      <span class="mh-story__yr">{{ section.settings.year }}</span>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <span class="mh-story__eye">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="mh-story__h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="mh-story__p">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <a href="{{ section.settings.cta_link }}" class="mh-btn-o" style="width:fit-content;">{{ section.settings.cta_label }}</a>
    {%- endif -%}
    <div class="mh-story__stats">
      {%- for i in (1..3) -%}
        {%- assign stat_n_key = 'stat' | append: i | append: '_number' -%}
        {%- assign stat_l_key = 'stat' | append: i | append: '_label' -%}
        {%- if section.settings[stat_n_key] != blank -%}
          <div>
            <span class="mh-story__stat-n">{{ section.settings[stat_n_key] }}</span>
            <span class="mh-story__stat-l">{{ section.settings[stat_l_key] }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Brand Story",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Left image", "info": "Replaces the abstract SVG when set." },
    { "type": "text", "id": "year", "label": "Founding year", "default": "2004" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Born in\nMelbourne" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Founded in Melbourne in 2004, MARAIS is a multi-brand luxury boutique curating the world's most influential designers. With five boutiques across the city and a global online presence, we bring Balenciaga, Maison Margiela, Rick Owens, Loewe and more under one roof." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Discover Our Story" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "header", "content": "Stats" },
    { "type": "text", "id": "stat1_number", "label": "Stat 1 number", "default": "20+" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Years" },
    { "type": "text", "id": "stat2_number", "label": "Stat 2 number", "default": "5" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "Boutiques" },
    { "type": "text", "id": "stat3_number", "label": "Stat 3 number", "default": "50+" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Global Brands" }
  ],
  "presets": [{ "name": "Brand Story" }]
}
{% endschema %}
