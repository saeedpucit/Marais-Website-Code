{%- assign layout = section.settings.layout | default: 'image-left' -%}
{%- assign bg = section.settings.bg_color | default: 'var(--mh-cream)' -%}
{%- assign text_col = section.settings.text_color | default: 'var(--mh-black)' -%}

<div class="mh-split mh-split--{{ layout }}"{% unless section.settings.gender == 'both' %} data-gender="{{ section.settings.gender }}"{% endunless %} style="background-color: {{ bg }}; --split-text: {{ text_col }}; --split-inv: {{ bg }}">

  <div class="mh-split__image">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1200 }}"
        alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {%- else -%}
      <div class="mh-split__placeholder"></div>
    {%- endif -%}
  </div>

  <div class="mh-split__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="mh-split__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="mh-split__heading">
      {{ section.settings.heading }}
      {%- if section.settings.heading_italic != blank -%}
        <em>{{ section.settings.heading_italic }}</em>
      {%- endif -%}
    </h2>
    {%- if section.settings.body != blank -%}
      <p class="mh-split__body">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <a href="{{ section.settings.cta_link }}" class="mh-btn">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>

</div>

{% schema %}
{
  "name": "Collection Banner",
  "tag": "section",
  "class": "mh-split-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image-left",  "label": "Image left" },
        { "value": "image-right", "label": "Image right" }
      ],
      "default": "image-left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "placeholder": "New Season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "placeholder": "The"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading italic (appended)",
      "placeholder": "Edit"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "placeholder": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#f5f2ed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#0a0a0a"
    },
    { "type": "select", "id": "gender", "label": "Show for", "options": [{ "value": "both", "label": "Everyone" }, { "value": "women", "label": "Women only" }, { "value": "men", "label": "Men only" }], "default": "both" }
  ],
  "presets": [
    {
      "name": "Collection Banner",
      "settings": {
        "eyebrow": "New Season",
        "heading": "The",
        "heading_italic": "Edit",
        "body": "Curated arrivals from the world's most influential designers.",
        "cta_label": "Explore Now",
        "layout": "image-left"
      }
    }
  ]
}
{% endschema %}
