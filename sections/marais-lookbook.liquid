{{ 'marais-lookbook.css' | asset_url | stylesheet_tag }}

<!-- Progress bar -->
<div class="lookbook-progress" aria-hidden="true">
  <div class="lookbook-progress__fill"></div>
</div>

<!-- Slide counter -->
<div class="lookbook__counter" aria-hidden="true">1 / {{ section.blocks.size }}</div>

<div class="lookbook" tabindex="0" aria-label="Lookbook — use arrow keys to navigate">

  {%- for block in section.blocks -%}
    <div class="lookbook__slide" id="LookbookSlide-{{ forloop.index }}" {{ block.shopify_attributes }}>

      <!-- Background image -->
      {%- if block.settings.image != blank -%}
        <img
          class="lookbook__media"
          src="{{ block.settings.image | image_url: width: 2200 }}"
          srcset="
            {{ block.settings.image | image_url: width: 1200 }} 1200w,
            {{ block.settings.image | image_url: width: 1800 }} 1800w,
            {{ block.settings.image | image_url: width: 2200 }} 2200w
          "
          sizes="100vw"
          alt="{{ block.settings.image.alt | escape | default: block.settings.heading | escape }}"
          {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
          width="2200"
          height="1240"
        >
      {%- else -%}
        <div style="position:absolute;inset:0;background:linear-gradient(135deg,#111 0%,#222 100%)"></div>
      {%- endif -%}

      <div class="lookbook__overlay"></div>

      <!-- Content -->
      <div class="lookbook__content">
        {%- if block.settings.eyebrow != blank -%}
          <span class="lookbook__eyebrow">{{ block.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="lookbook__title">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.body != blank -%}
          <p class="lookbook__body">{{ block.settings.body }}</p>
        {%- endif -%}
        <div style="display:flex;align-items:center;flex-wrap:wrap;gap:8px">
          {%- if block.settings.cta_label != blank and block.settings.cta_link != blank -%}
            <a href="{{ block.settings.cta_link }}" class="lookbook__cta">{{ block.settings.cta_label }}</a>
          {%- endif -%}
          {%- assign has_products = false -%}
          {%- for i in (1..4) -%}
            {%- assign pkey = 'product_' | append: i -%}
            {%- if block.settings[pkey] != blank -%}{%- assign has_products = true -%}{%- endif -%}
          {%- endfor -%}
          {%- if has_products -%}
            <button class="lookbook__shop-btn" aria-expanded="false">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 12 15 18 9"/></svg>
              <span>Shop This Look</span>
            </button>
          {%- endif -%}
        </div>
      </div>

      <!-- Shop This Look product strip -->
      {%- if has_products -%}
        <div class="lookbook__products">
          {%- for i in (1..4) -%}
            {%- assign pkey = 'product_' | append: i -%}
            {%- assign lp = block.settings[pkey] -%}
            {%- if lp != blank -%}
              <a href="{{ lp.url }}" class="lookbook__product">
                {%- if lp.featured_image -%}
                  <img
                    class="lookbook__product-img"
                    src="{{ lp.featured_image | image_url: width: 200 }}"
                    alt="{{ lp.featured_image.alt | escape | default: lp.title | escape }}"
                    loading="lazy"
                    width="44"
                    height="58"
                  >
                {%- else -%}
                  <div class="lookbook__product-img"></div>
                {%- endif -%}
                <div class="lookbook__product-info">
                  <p class="lookbook__product-vendor">{{ lp.vendor }}</p>
                  <p class="lookbook__product-title">{{ lp.title }}</p>
                  <p class="lookbook__product-price">{{ lp.price | money }}</p>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  {%- endfor -%}

</div>

<script src="{{ 'marais-lookbook.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "lookbook-section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "placeholder": "F/W 2025"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "placeholder": "Shop Now"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link"
        },
        {
          "type": "header",
          "content": "Shop This Look — Products"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "F/W 2025",
            "heading": "The Edit",
            "body": "Defining pieces curated for the season ahead.",
            "cta_label": "Shop Now",
            "cta_link": "/collections/all"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Campaign",
            "heading": "Dressed\nwith Intention",
            "cta_label": "Explore",
            "cta_link": "/blogs/news"
          }
        }
      ]
    }
  ]
}
{% endschema %}
