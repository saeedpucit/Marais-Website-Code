<div class="mh-nl">
  <div class="mh-nl__inner">
    <h2 class="mh-nl__h2">{{ section.settings.heading }} <em>{{ section.settings.heading_italic }}</em></h2>
    {%- if section.settings.subtext != blank -%}
      <p class="mh-nl__sub">{{ section.settings.subtext }}</p>
    {%- endif -%}
    {%- form 'customer', id: 'marais-nl-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="mh-nl__form">
        <input
          class="mh-nl__input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="mh-nl__btn">{{ section.settings.button_label }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p style="color:rgba(255,255,255,0.6);font-size:13px;margin-top:16px;font-family:var(--mh-sans);">Thank you for subscribing.</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay" },
    { "type": "text", "id": "heading_italic", "label": "Heading italic word", "default": "Connected" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Be the first to discover new arrivals, exclusive offers, editorial features, and events — directly to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
