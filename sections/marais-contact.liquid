<div class="mh-contact">

  <!-- ── Store info ── -->
  <div class="mh-contact__info">
    <h2 class="mh-contact__info-heading">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading }}
      {%- else -%}
        Get in Touch
      {%- endif -%}
    </h2>
    {%- if section.settings.response_promise != blank -%}
      <p class="mh-contact__promise">{{ section.settings.response_promise }}</p>
    {%- endif -%}

    {%- if section.settings.email != blank -%}
      <div class="mh-contact__detail">
        <p class="mh-contact__detail-lbl">Email</p>
        <p class="mh-contact__detail-val"><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
      </div>
    {%- endif -%}

    {%- if section.settings.phone != blank -%}
      <div class="mh-contact__detail">
        <p class="mh-contact__detail-lbl">Phone</p>
        <p class="mh-contact__detail-val"><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></p>
      </div>
    {%- endif -%}

    {%- if section.settings.hours != blank -%}
      <div class="mh-contact__detail">
        <p class="mh-contact__detail-lbl">Hours</p>
        <p class="mh-contact__detail-val">{{ section.settings.hours | newline_to_br }}</p>
      </div>
    {%- endif -%}
  </div>

  <!-- ── Contact form ── -->
  <div class="mh-contact__form">
    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p style="color: var(--mh-gold); font-size: 13px; font-family: var(--mh-sans); letter-spacing: .04em; margin-bottom: 24px;">
          Thank you — we'll be in touch shortly.
        </p>
      {%- endif -%}

      {%- if form.errors -%}
        <ul style="color: var(--mh-red); font-size: 12px; font-family: var(--mh-sans); margin-bottom: 20px; list-style: none;">
          {%- for error in form.errors -%}
            <li>{{ error | capitalize }}: {{ form.errors.messages[error] }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="mh-contact__field">
        <label class="mh-contact__label" for="ContactName">Name</label>
        <input
          id="ContactName"
          class="mh-contact__input"
          type="text"
          name="contact[name]"
          value="{{ form.name }}"
          autocomplete="name"
          placeholder="Your full name"
        >
      </div>

      <div class="mh-contact__field">
        <label class="mh-contact__label" for="ContactEmail">Email</label>
        <input
          id="ContactEmail"
          class="mh-contact__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocomplete="email"
          placeholder="your@email.com"
          required
        >
      </div>

      <div class="mh-contact__field">
        <label class="mh-contact__label" for="ContactSubject">Subject</label>
        <select id="ContactSubject" class="mh-contact__select" name="contact[body][subject]">
          <option value="">Select a subject</option>
          <option value="Order Enquiry">Order Enquiry</option>
          <option value="Returns & Exchanges">Returns &amp; Exchanges</option>
          <option value="Styling Advice">Styling Advice</option>
          <option value="Press & Partnerships">Press &amp; Partnerships</option>
          <option value="General Enquiry">General Enquiry</option>
        </select>
      </div>

      <div class="mh-contact__field">
        <label class="mh-contact__label" for="ContactMessage">Message</label>
        <textarea
          id="ContactMessage"
          class="mh-contact__textarea"
          name="contact[body]"
          placeholder="How can we help you?"
          rows="6"
        >{{ form.body }}</textarea>
      </div>

      <button type="submit" class="mh-contact__submit">Send Message</button>

    {%- endform -%}
  </div>

</div>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "response_promise",
      "label": "Response promise",
      "placeholder": "We respond within 1 business day"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "placeholder": "hello@marais.com.au"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "placeholder": "+61 3 9827 0000"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Business hours",
      "placeholder": "Mon–Fri 9am–5pm AEST"
    }
  ],
  "presets": [
    {
      "name": "Contact",
      "settings": {
        "heading": "Get in Touch",
        "response_promise": "We respond within 1 business day",
        "email": "hello@marais.com.au",
        "phone": "+61 3 9827 0000",
        "hours": "Mon–Fri 9am–5pm AEST\nSat 10am–4pm AEST"
      }
    }
  ]
}
{% endschema %}
