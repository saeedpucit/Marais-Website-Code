{{ 'luxury-editorial.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign text_position = section.settings.text_position | default: 'bottom'
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign has_link1 = false
  assign has_link2 = false
  if section.settings.link1_label != blank and section.settings.link1_url != blank
    assign has_link1 = true
  endif
  if section.settings.link2_label != blank and section.settings.link2_url != blank
    assign has_link2 = true
  endif
-%}

<div class="luxury-editorial">
  {%- if section.settings.image != blank -%}
    {%- assign mobile_src = section.settings.mobile_image | default: section.settings.image -%}
    <img
      src="{{ mobile_src | image_url: width: 750 }}"
      alt="{{ section.settings.heading | escape }}"
      class="luxury-editorial__media luxury-editorial__media--mobile"
      loading="lazy"
      width="750"
      height="1000"
    >
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      srcset="
        {{ section.settings.image | image_url: width: 1100 }} 1100w,
        {{ section.settings.image | image_url: width: 1500 }} 1500w,
        {{ section.settings.image | image_url: width: 2000 }} 2000w
      "
      sizes="100vw"
      alt="{{ section.settings.heading | escape }}"
      class="luxury-editorial__media luxury-editorial__media--desktop"
      loading="lazy"
      width="2000"
      height="1125"
    >
  {%- else -%}
    <div style="width:100%;height:85vh;min-height:400px;background:#111;"></div>
  {%- endif -%}

  <div class="luxury-editorial__overlay" style="background: rgba(0,0,0,{{ overlay_opacity }});"></div>

  <div class="luxury-editorial__content luxury-editorial__content--{{ text_position }}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="luxury-editorial__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <span class="luxury-editorial__heading">{{ section.settings.heading }}</span>
    {%- endif -%}
    {%- if has_link1 or has_link2 -%}
      <div class="luxury-editorial__links">
        {%- if has_link1 -%}
          <a href="{{ section.settings.link1_url }}" class="luxury-editorial__link">
            {{ section.settings.link1_label }}
          </a>
        {%- endif -%}
        {%- if has_link2 -%}
          <a href="{{ section.settings.link2_url }}" class="luxury-editorial__link">
            {{ section.settings.link2_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Editorial Banner",
  "tag": "section",
  "class": "luxury-editorial-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Portrait crop for phones. Falls back to desktop image if not set."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Image overlay darkness",
      "default": 20
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "info": "Small label above heading, e.g. SS25 or EXPLORE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "CTA Links"
    },
    {
      "type": "text",
      "id": "link1_label",
      "label": "Link 1 label"
    },
    {
      "type": "url",
      "id": "link1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link2_label",
      "label": "Link 2 label"
    },
    {
      "type": "url",
      "id": "link2_url",
      "label": "Link 2 URL"
    }
  ],
  "presets": [
    {
      "name": "Editorial Banner"
    }
  ]
}
{% endschema %}
