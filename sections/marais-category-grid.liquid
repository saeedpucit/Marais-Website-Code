<section class="mh-cat-sec">
  <div style="max-width:1440px;margin:0 auto;">
    <div class="mh-sec__hdr mh-fu">
      <div>
        <p class="mh-sec__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="mh-sec__title">{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.see_all_label != blank and section.settings.see_all_link != blank -%}
        <a href="{{ section.settings.see_all_link }}" class="mh-see-all">{{ section.settings.see_all_label }}</a>
      {%- endif -%}
    </div>
    <div class="mh-cat__grid mh-fu">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="mh-cat__card" {{ block.shopify_attributes }}>
          <div class="mh-cat__bg" style="background-color: {{ block.settings.bg_color }};">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1000 }}"
                alt="{{ block.settings.name | escape }}"
                loading="lazy"
                style="width:100%;height:100%;object-fit:cover;display:block;"
              >
            {%- endif -%}
          </div>
          <div class="mh-cat__overlay">
            {%- if block.settings.label != blank -%}
              <p class="mh-cat__label">{{ block.settings.label }}</p>
            {%- endif -%}
            <h3 class="mh-cat__name">{{ block.settings.name }}</h3>
          </div>
          <span class="mh-cat__arrow">→</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function () {
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('mh-vis'); });
  }, { threshold: 0.08 });
  document.querySelectorAll('.mh-cat-sec .mh-fu').forEach(function (el) { io.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by Category" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Edit" },
    { "type": "text", "id": "see_all_label", "label": "See all label", "default": "Shop All" },
    { "type": "url", "id": "see_all_link", "label": "See all link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "color", "id": "bg_color", "label": "Fallback background colour", "default": "#12122a" },
        { "type": "text", "id": "label", "label": "Eyebrow label", "default": "New Season" },
        { "type": "text", "id": "name", "label": "Category name", "default": "Outerwear" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { "type": "category", "settings": { "label": "New Season", "name": "Down Jackets &\nOuterwear", "bg_color": "#12122a" } },
        { "type": "category", "settings": { "label": "Footwear", "name": "Shoes &\nSneakers", "bg_color": "#0d1a0c" } },
        { "type": "category", "settings": { "label": "Carry", "name": "Bags", "bg_color": "#1a0c0c" } },
        { "type": "category", "settings": { "label": "Finish", "name": "Accessories", "bg_color": "#0c0c1a" } },
        { "type": "category", "settings": { "label": "Lifestyle", "name": "Home &\nObjects", "bg_color": "#1a180a" } }
      ]
    }
  ]
}
{% endschema %}
