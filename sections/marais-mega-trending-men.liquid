<div id="mh-trending-src-men" hidden>
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.url | default: '#' }}" class="mh-trending-card" {{ block.shopify_attributes }}>
      <div class="mh-trending-card__img">
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 600 }}"
            srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w"
            sizes="33vw"
            alt="{{ block.settings.heading }}"
            loading="lazy"
            width="600"
          >
        {%- else -%}
          <div class="mh-trending-card__placeholder"></div>
        {%- endif -%}
      </div>
      <div class="mh-trending-card__body">
        {%- if block.settings.subheading != blank -%}
          <span class="mh-trending-card__sub">{{ block.settings.subheading }}</span>
        {%- endif -%}
        <span class="mh-trending-card__title">{{ block.settings.heading }}</span>
      </div>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Mega Trending — Men",
  "settings": [],
  "blocks": [
    {
      "type": "collection",
      "name": "Trending Card",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image",      "label": "Image" },
        { "type": "text",         "id": "heading",    "label": "Heading",    "placeholder": "New Arrivals" },
        { "type": "text",         "id": "subheading", "label": "Subheading", "placeholder": "Men" },
        { "type": "url",          "id": "url",        "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mega Trending — Men",
      "blocks": [
        { "type": "collection", "settings": { "heading": "New Arrivals",  "subheading": "Men" } },
        { "type": "collection", "settings": { "heading": "Trending Now",  "subheading": "This Season" } },
        { "type": "collection", "settings": { "heading": "The Edit",      "subheading": "Curated" } }
      ]
    }
  ]
}
{% endschema %}
