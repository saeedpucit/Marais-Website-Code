<div class="mh-sec mh-prod-sec">
  <div class="mh-sec__inner">
    <div class="mh-sec__hdr mh-fu">
      <div>
        <p class="mh-sec__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="mh-sec__title">{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.see_all_label != blank and section.settings.see_all_link != blank -%}
        <a href="{{ section.settings.see_all_link }}" class="mh-see-all">{{ section.settings.see_all_label }}</a>
      {%- endif -%}
    </div>

    <div class="mh-prod__tabs mh-fu">
      {%- for block in section.blocks -%}
        <button
          class="mh-prod__tab{% if forloop.first %} mh-prod__tab--active{% endif %}"
          data-tab="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <div
        class="mh-prod__panel{% if forloop.first %} mh-prod__panel--active{% endif %}"
        data-panel="{{ forloop.index0 }}"
      >
        {%- if col != blank -%}
          <div class="mh-prod__grid">
            {%- for product in col.products limit: section.settings.products_to_show -%}
              <a href="{{ product.url }}" class="mh-prod__card">
                <div class="mh-prod__img-wrap">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="600"
                    >
                  {%- else -%}
                    <div class="mh-prod__placeholder"></div>
                  {%- endif -%}
                  {%- if product.images[1] -%}
                    <img
                      class="mh-prod__img-hover"
                      src="{{ product.images[1] | image_url: width: 600 }}"
                      alt=""
                      loading="lazy"
                      width="600"
                    >
                  {%- endif -%}
                  {%- if product.compare_at_price > product.price -%}
                    <span class="mh-prod__badge mh-prod__badge--sale">Sale</span>
                  {%- endif -%}
                </div>
                <div class="mh-prod__info">
                  {%- if section.settings.show_vendor -%}
                    <p class="mh-prod__vendor">{{ product.vendor }}</p>
                  {%- endif -%}
                  <p class="mh-prod__name">{{ product.title }}</p>
                  <p class="mh-prod__price">
                    {%- if product.compare_at_price > product.price -%}
                      <s class="mh-prod__price-was">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                    {{ product.price | money }}
                  </p>
                </div>
              </a>
            {%- endfor -%}
          </div>
        {%- else -%}
          <p style="color:var(--mh-gray);font-size:13px;font-family:var(--mh-sans);padding:24px 0;">
            Select a collection in the theme editor.
          </p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
.mh-prod-sec { background: var(--mh-white); }
.mh-prod__tabs {
  display: flex;
  gap: 0;
  border-bottom: 1px solid var(--mh-light);
  margin-bottom: 40px;
}
.mh-prod__tab {
  background: none;
  border: none;
  padding: 14px 28px;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-family: var(--mh-sans);
  color: var(--mh-gray);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  transition: color 0.2s, border-color 0.2s;
}
.mh-prod__tab--active { color: var(--mh-black); border-bottom-color: var(--mh-black); }
.mh-prod__panel { display: none; }
.mh-prod__panel--active { display: block; }
.mh-prod__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px 16px;
}
.mh-prod__card {
  text-decoration: none;
  color: var(--mh-black);
  display: block;
}
.mh-prod__img-wrap {
  position: relative;
  overflow: hidden;
  background: var(--mh-cream);
  aspect-ratio: 3/4;
  margin-bottom: 14px;
}
.mh-prod__img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: opacity 0.4s;
}
.mh-prod__img-hover {
  position: absolute;
  inset: 0;
  opacity: 0;
}
.mh-prod__card:hover .mh-prod__img-hover { opacity: 1; }
.mh-prod__placeholder { width: 100%; height: 100%; background: var(--mh-light); }
.mh-prod__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-family: var(--mh-sans);
  background: var(--mh-black);
  color: #fff;
  padding: 4px 8px;
}
.mh-prod__badge--sale { background: var(--mh-red); }
.mh-prod__vendor {
  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--mh-gray);
  margin: 0 0 5px;
  font-family: var(--mh-sans);
}
.mh-prod__name {
  font-family: var(--mh-serif);
  font-size: 16px;
  font-weight: 300;
  margin: 0 0 7px;
  line-height: 1.3;
}
.mh-prod__price {
  font-size: 13px;
  font-family: var(--mh-sans);
  color: var(--mh-black);
  margin: 0;
  display: flex;
  gap: 8px;
  align-items: baseline;
}
.mh-prod__price-was { color: var(--mh-gray); text-decoration: line-through; }
@media (max-width: 1100px) { .mh-prod__grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 768px) {
  .mh-prod__grid { grid-template-columns: repeat(2, 1fr); gap: 16px 10px; }
  .mh-prod__tab { padding: 12px 16px; font-size: 10px; }
}
</style>

<script>
(function () {
  document.querySelectorAll('.mh-prod__tab').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var sec = btn.closest('.mh-prod-sec');
      var idx = btn.dataset.tab;
      sec.querySelectorAll('.mh-prod__tab').forEach(function (b) { b.classList.remove('mh-prod__tab--active'); });
      sec.querySelectorAll('.mh-prod__panel').forEach(function (p) { p.classList.remove('mh-prod__panel--active'); });
      btn.classList.add('mh-prod__tab--active');
      sec.querySelector('.mh-prod__panel[data-panel="' + idx + '"]').classList.add('mh-prod__panel--active');
    });
  });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('mh-vis'); });
  }, { threshold: 0.05 });
  document.querySelectorAll('.mh-prod-sec .mh-fu').forEach(function (el) { io.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just Arrived" },
    { "type": "text", "id": "title", "label": "Title", "default": "Just In" },
    { "type": "text", "id": "see_all_label", "label": "See all label", "default": "View All" },
    { "type": "url", "id": "see_all_link", "label": "See all link" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 4, "default": 8, "label": "Products to show" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Collection Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Women" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products",
      "blocks": [
        { "type": "tab", "settings": { "label": "Women" } },
        { "type": "tab", "settings": { "label": "Men" } }
      ]
    }
  ]
}
{% endschema %}
