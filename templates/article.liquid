{%- assign word_count = article.content | strip_html | split: ' ' | size -%}
{%- assign read_time = word_count | divided_by: 200 -%}
{%- if read_time < 1 -%}{%- assign read_time = 1 -%}{%- endif -%}

<article class="article-page">

  <!-- ── Hero ── -->
  <div class="article-hero">
    {%- if article.image -%}
      <img
        class="article-hero__img"
        src="{{ article.image | image_url: width: 2200 }}"
        srcset="
          {{ article.image | image_url: width: 1200 }} 1200w,
          {{ article.image | image_url: width: 1800 }} 1800w,
          {{ article.image | image_url: width: 2200 }} 2200w
        "
        sizes="100vw"
        alt="{{ article.image.alt | escape | default: article.title | escape }}"
        loading="eager"
        width="2200"
        height="1240"
      >
    {%- endif -%}
    <div class="article-hero__overlay"></div>
    <div class="article-hero__content">
      {%- if article.tags.first -%}
        <span class="article-hero__tag">{{ article.tags.first }}</span>
      {%- endif -%}
      <h1 class="article-hero__title">{{ article.title }}</h1>
    </div>
  </div>

  <!-- ── Meta bar ── -->
  <div class="article-meta">
    {%- if article.author != blank -%}
      <span>{{ article.author }}</span>
      <span class="article-meta__sep"></span>
    {%- endif -%}
    <span>{{ article.published_at | date: '%d %B %Y' }}</span>
    <span class="article-meta__sep"></span>
    <span>{{ read_time }} min read</span>
    {%- if article.tags.size > 0 -%}
      <span class="article-meta__sep"></span>
      {%- for tag in article.tags -%}
        {{ tag | link_to_tag: tag }}{% unless forloop.last %}, {% endunless %}
      {%- endfor -%}
    {%- endif -%}
  </div>

  <!-- ── Body ── -->
  <div class="article-body">
    {{ article.content }}
  </div>

  <!-- ── Related articles ── -->
  {%- assign related_articles = '' | split: '' -%}
  {%- if article.tags.size > 0 -%}
    {%- for a in blog.articles -%}
      {%- if a.handle == article.handle -%}{%- continue -%}{%- endif -%}
      {%- assign is_related = false -%}
      {%- for tag in article.tags -%}
        {%- if a.tags contains tag -%}
          {%- assign is_related = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if is_related and related_articles.size < 3 -%}
        {%- assign related_articles = related_articles | push: a -%}
      {%- endif -%}
      {%- if related_articles.size >= 3 -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if related_articles.size > 0 -%}
    <div class="article-related">
      <div class="article-related__header">
        <p class="article-related__eyebrow">Continue Reading</p>
        <h2 class="article-related__title">Related Stories</h2>
      </div>
      <div class="article-related__grid">
        {%- for a in related_articles -%}
          {%- render 'editorial-card', article: a -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <!-- ── Newsletter ── -->
  {%- section 'marais-newsletter' -%}

</article>
