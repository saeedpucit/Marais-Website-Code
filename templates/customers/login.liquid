<div class="mac-page">

  <!-- LEFT: Forms -->
  <div class="mac-left">
    <div class="mac-left__inner">

      <a href="/" class="mac-logo" aria-label="MARAIS">
        <img src="{{ 'logo transparent 9 1.png' | asset_url }}" alt="MARAIS" height="28" style="height:28px;width:auto;display:block;">
      </a>

      <div class="mac-tabs" role="tablist">
        <button class="mac-tab is-active" data-panel="login" role="tab" aria-selected="true">Sign In</button>
        <button class="mac-tab" data-panel="register" role="tab" aria-selected="false">Create Account</button>
      </div>

      <!-- Login -->
      <div class="mac-panel is-active" id="mac-panel-login">
        <p class="mac-sub">Welcome back to MARAIS</p>
        {%- form 'customer_login' -%}
          {%- if form.errors -%}
            <ul class="mac-errors">
              {%- for error in form.errors -%}<li>{{ form.errors.messages[error] }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="mac-field">
            <label class="mac-label" for="CustomerEmail">Email</label>
            <input id="CustomerEmail" class="mac-input" type="email" name="customer[email]" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="your@email.com" required>
          </div>
          <div class="mac-field">
            <label class="mac-label" for="CustomerPassword">Password</label>
            <input id="CustomerPassword" class="mac-input" type="password" name="customer[password]" autocomplete="current-password" placeholder="••••••••" required>
            <a href="{{ routes.account_recover_url }}" class="mac-forgot">Forgot password?</a>
          </div>
          <button type="submit" class="mac-btn">Sign In</button>
        {%- endform -%}
      </div>

      <!-- Register -->
      <div class="mac-panel" id="mac-panel-register">
        <p class="mac-sub">Join the MARAIS community</p>
        {%- form 'create_customer' -%}
          {%- if form.errors -%}
            <ul class="mac-errors">
              {%- for error in form.errors -%}<li>{{ form.errors.messages[error] }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="mac-field mac-field--row">
            <div>
              <label class="mac-label" for="FirstName">First Name</label>
              <input id="FirstName" class="mac-input" type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name">
            </div>
            <div>
              <label class="mac-label" for="LastName">Last Name</label>
              <input id="LastName" class="mac-input" type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name">
            </div>
          </div>
          <div class="mac-field">
            <label class="mac-label" for="RegisterEmail">Email</label>
            <input id="RegisterEmail" class="mac-input" type="email" name="customer[email]" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="your@email.com" required>
          </div>
          <div class="mac-field">
            <label class="mac-label" for="CreatePassword">Password</label>
            <input id="CreatePassword" class="mac-input" type="password" name="customer[password]" autocomplete="new-password" placeholder="Minimum 5 characters" required>
          </div>
          <button type="submit" class="mac-btn">Create Account</button>
        {%- endform -%}
      </div>

    </div>
  </div>

  <!-- RIGHT: Perks -->
  <div class="mac-right">
    <div class="mac-right__inner">
      <p class="mac-right__eyebrow">Marais Membership</p>
      <h2 class="mac-right__heading">A world of exclusive member benefits</h2>
      <ul class="mac-perks">
        <li class="mac-perk">
          <span class="mac-perk__num">01</span>
          <div>
            <strong class="mac-perk__title">Early Access</strong>
            <p class="mac-perk__desc">Shop new arrivals 24 hours before anyone else</p>
          </div>
        </li>
        <li class="mac-perk">
          <span class="mac-perk__num">02</span>
          <div>
            <strong class="mac-perk__title">Complimentary Alterations</strong>
            <p class="mac-perk__desc">Expert tailoring at no extra cost, across every boutique</p>
          </div>
        </li>
        <li class="mac-perk">
          <span class="mac-perk__num">03</span>
          <div>
            <strong class="mac-perk__title">Personal Styling</strong>
            <p class="mac-perk__desc">Dedicated style consultants available in-store and online</p>
          </div>
        </li>
        <li class="mac-perk">
          <span class="mac-perk__num">04</span>
          <div>
            <strong class="mac-perk__title">Exclusive Events</strong>
            <p class="mac-perk__desc">Private viewings, designer evenings and curated experiences</p>
          </div>
        </li>
      </ul>
    </div>
  </div>

</div>

<script>
(function () {
  var tabs   = document.querySelectorAll('.mac-tab');
  var panels = document.querySelectorAll('.mac-panel');
  function activate(i) {
    tabs.forEach(function (t, j) { t.classList.toggle('is-active', j === i); t.setAttribute('aria-selected', String(j === i)); });
    panels.forEach(function (p, j) { p.classList.toggle('is-active', j === i); });
  }
  tabs.forEach(function (tab, i) { tab.addEventListener('click', function () { activate(i); }); });
  if (document.querySelector('#mac-panel-register .mac-errors')) activate(1);
  if (window.location.hash === '#register') activate(1);
})();
</script>