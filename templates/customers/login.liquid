    </a>

    <h1 class="auth-page__heading">Welcome Back</h1>
    <p class="auth-page__sub">Sign in to your MARAIS account</p>

    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <ul class="auth-errors">
          {%- for error in form.errors -%}
            <li>{{ error | capitalize }}: {{ form.errors.messages[error] }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="auth-form">
        <div class="auth-form__field">
          <label class="auth-form__label" for="CustomerEmail">Email</label>
          <input
            id="CustomerEmail"
            class="auth-form__input"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder="your@email.com"
            required
          >
        </div>

        <div class="auth-form__field">
          <label class="auth-form__label" for="CustomerPassword">Password</label>
          <input
            id="CustomerPassword"
            class="auth-form__input"
            type="password"
            name="customer[password]"
            autocomplete="current-password"
            placeholder="••••••••"
            required
          >
          <a href="{{ routes.account_recover_url }}" class="auth-form__forgot">Forgot password?</a>
        </div>

        <button type="submit" class="auth-form__btn">Sign In</button>
      </div>
    {%- endform -%}

    <p class="auth-page__switch">
      New to MARAIS? <a href="{{ routes.account_register_url }}">Create an account</a>
    </p>

  </div>
</div>
