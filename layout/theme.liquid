<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {%- if template.name == 'index' -%}
    <title>MARAIS — Luxury Fashion Clothes &amp; Accessories</title>
    <meta name="description" content="MARAIS is Australia's premier destination for luxury fashion. Shop Maison Margiela, Loewe, Rick Owens &amp; more for men and women online or in Melbourne boutiques.">
  {%- else -%}
    <title>{{ page_title }} — {{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">

  {{ content_for_header }}

  {{ 'marais-homepage.css' | asset_url | stylesheet_tag }}
  {%- if template.name == 'collection' or template.name == 'index' or template.name == 'search' -%}
    {{ 'marais-collection.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {{ 'marais-search.css' | asset_url | stylesheet_tag }}
  {%- if template.name == 'cart' -%}
    {{ 'marais-cart.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if template.directory == 'customers' or template.name == 'account' -%}
    {{ 'marais-account.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if template.name == '404' or template.name == 'page' or template.name == 'blog' or template.name == 'article' -%}
    {{ 'marais-pages.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {%- if template.name == 'blog' or template.name == 'article' -%}
    {{ 'marais-editorial.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
</head>

<body class="mh-body">

  <!-- ANNOUNCEMENT BAR -->
  {%- section 'marais-announcement-bar' -%}

  <!-- HEADER -->
  <header class="mh-header" id="mh-header">

    <!-- ── Row 1: gender tabs · logo · icons ── -->
    <div class="mh-hdr">
      <div class="mh-hdr__inner">

        <!-- Gender tabs (left) -->
        <div class="mh-gender">
          <button class="mh-gender__tab js-gender" data-g="women">Women</button>
          <span class="mh-gender__sep" aria-hidden="true">/</span>
          <button class="mh-gender__tab js-gender" data-g="men">Men</button>
        </div>

        <!-- Centred Logo -->
        <div class="mh-logo">
          <a href="/" aria-label="MARAIS">
            <img
              src="{{ 'logo transparent 9 1.png' | asset_url }}"
              alt="MARAIS"
              height="36"
              width="auto"
              style="height:36px;width:auto;display:block;"
            >
          </a>
        </div>

        <!-- Right Icons -->
        <div class="mh-hdr__right">
          <button class="mh-icon-btn mh-hide-mob" id="mh-search-trigger" aria-label="Search" aria-expanded="false" aria-controls="mh-search-panel">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </button>
          <a href="/account" class="mh-icon-btn mh-hide-mob" aria-label="Account">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </a>
          <button class="mh-icon-btn mh-cart-btn" id="mh-cart-trigger" aria-label="Open cart" aria-expanded="false" aria-controls="mh-cart-drawer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            <span class="mh-cart-badge" id="mh-cart-badge" {%- if cart.item_count == 0 -%} style="display:none" {%- endif -%}>{{ cart.item_count }}</span>
          </button>
          <button class="mh-icon-btn mh-burger mh-show-mob" aria-label="Open menu" aria-expanded="false" aria-controls="mh-mob-nav">
            <span class="mh-burger__bar"></span>
            <span class="mh-burger__bar"></span>
            <span class="mh-burger__bar"></span>
          </button>
        </div>

      </div>
    </div>

    <!-- ── Row 2: Women category nav ── -->
    <nav class="mh-subnav" data-g="women" aria-label="Women">
      <div class="mh-subnav__inner">
        {%- for link in linklists['womens-menu'].links -%}
          {%- assign link_lower = link.title | downcase -%}
          {%- assign is_highlight = false -%}
          {%- if link_lower contains 'sale' or link_lower contains 'new arrivals' -%}
            {%- assign is_highlight = true -%}
          {%- endif -%}
          <div class="mh-subnav__item">
            <a href="{{ link.url }}"{% if is_highlight %} class="mh-highlight"{% endif %}>{{ link.title }}</a>
            {%- unless is_highlight -%}
              <div class="mh-mega{% if link.links.size == 0 %} mh-mega--slim{% endif %}">
                {%- if link.links.size > 0 -%}
                  <div class="mh-mega__main">
                    {%- if link_lower contains 'designer' -%}
                      <span class="mh-mega__lbl">Designers</span>
                      {%- assign half = link.links.size | divided_by: 2 -%}
                      <div class="mh-mega__brands-grid">
                        <div>{%- for child in link.links limit: half -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}</div>
                        <div>{%- for child in link.links offset: half -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}</div>
                      </div>
                    {%- else -%}
                      <div class="mh-mega__main-cols">
                        <div class="mh-mega__sub">
                          <span class="mh-mega__lbl">{{ link.title }}</span>
                          {%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div class="mh-mega__products" data-collection="{{ link.url }}">
                  <div class="mh-mega__products-list"><span class="mh-mega__loading">Loading&hellip;</span></div>
                </div>
              </div>
            {%- endunless -%}
          </div>
        {%- endfor -%}
      </div>
    </nav>

    <!-- ── Row 2: Men category nav ── -->
    <nav class="mh-subnav mh-subnav--hidden" data-g="men" aria-label="Men">
      <div class="mh-subnav__inner">
        {%- for link in linklists['mens-menu'].links -%}
          {%- assign link_lower = link.title | downcase -%}
          {%- assign is_highlight = false -%}
          {%- if link_lower contains 'sale' or link_lower contains 'new arrivals' -%}
            {%- assign is_highlight = true -%}
          {%- endif -%}
          <div class="mh-subnav__item">
            <a href="{{ link.url }}"{% if is_highlight %} class="mh-highlight"{% endif %}>{{ link.title }}</a>
            {%- unless is_highlight -%}
              <div class="mh-mega{% if link.links.size == 0 %} mh-mega--slim{% endif %}">
                {%- if link.links.size > 0 -%}
                  <div class="mh-mega__main">
                    {%- if link_lower contains 'designer' -%}
                      <span class="mh-mega__lbl">Designers</span>
                      {%- assign half = link.links.size | divided_by: 2 -%}
                      <div class="mh-mega__brands-grid">
                        <div>{%- for child in link.links limit: half -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}</div>
                        <div>{%- for child in link.links offset: half -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}</div>
                      </div>
                    {%- else -%}
                      <div class="mh-mega__main-cols">
                        <div class="mh-mega__sub">
                          <span class="mh-mega__lbl">{{ link.title }}</span>
                          {%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div class="mh-mega__products" data-collection="{{ link.url }}">
                  <div class="mh-mega__products-list"><span class="mh-mega__loading">Loading&hellip;</span></div>
                </div>
              </div>
            {%- endunless -%}
          </div>
        {%- endfor -%}
      </div>
    </nav>

    <script>
    (function () {
      /* Gender toggle */
      var stored = localStorage.getItem('mh-gender') || 'women';
      set(stored);
      document.querySelectorAll('.js-gender').forEach(function (btn) {
        btn.addEventListener('click', function () { set(this.dataset.g); localStorage.setItem('mh-gender', this.dataset.g); });
      });
      function set(g) {
        document.querySelectorAll('.js-gender').forEach(function (t) { t.classList.toggle('mh-gender__tab--active', t.dataset.g === g); });
        document.querySelectorAll('.mh-subnav').forEach(function (n) { n.classList.toggle('mh-subnav--hidden', n.dataset.g !== g); });
        document.querySelectorAll('[data-gender]').forEach(function (el) {
          var eg = el.dataset.gender;
          if (eg === 'both' || !eg) return;
          el.style.display = (eg === g) ? '' : 'none';
        });
        var gTab = document.querySelector('.mh-prod__tab[data-gender="' + g + '"]');
        if (gTab && !gTab.classList.contains('mh-prod__tab--active')) gTab.click();
      }

      /* Mega menu: lazy-load latest products on first hover */
      var _cache = {};
      function fmt(price) {
        return new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' }).format(price);
      }
      function loadProducts(panel) {
        var col = panel.dataset.collection;
        if (!col || panel.dataset.loaded) return;
        panel.dataset.loaded = '1';
        var grid = panel.querySelector('.mh-mega__products-list');
        if (_cache[col]) { render(grid, _cache[col]); return; }
        fetch(col + '/products.json?limit=3')
          .then(function(r){ return r.json(); })
          .then(function(d){
            _cache[col] = d.products || [];
            render(grid, _cache[col]);
          })
          .catch(function(){ grid.innerHTML = ''; });
      }
      function render(grid, products) {
        if (!products.length) { grid.innerHTML = ''; return; }
        grid.innerHTML = products.slice(0,3).map(function(p) {
          var img = p.images && p.images[0] ? p.images[0].src.replace(/(\.\w+)(\?.*)?$/, '_160x200_crop_center$1') : '';
          var price = p.variants && p.variants[0] ? fmt(p.variants[0].price) : '';
          return '<a href="/products/' + p.handle + '" class="mh-mega__product">'
            + '<div class="mh-mega__product-img">' + (img ? '<img src="' + img + '" alt="" loading="lazy">' : '') + '</div>'
            + '<div class="mh-mega__product-info">'
            + '<span class="mh-mega__product-brand">' + p.vendor + '</span>'
            + '<span class="mh-mega__product-title">' + p.title + '</span>'
            + '<span class="mh-mega__product-price">' + price + '</span>'
            + '</div></a>';
        }).join('');
      }
      document.querySelectorAll('.mh-subnav__item').forEach(function(item) {
        item.addEventListener('mouseenter', function() {
          var panel = this.querySelector('.mh-mega__products');
          if (panel) loadProducts(panel);
        });
      });
    }());
    </script>

    <!-- HEADER SEARCH PANEL -->
    <div class="mh-search-panel" id="mh-search-panel" aria-hidden="true" role="search">
      <div class="mh-search-panel__inner">
        <form class="mh-search-panel__form" action="/search" method="get">
          <input type="hidden" name="type" value="product,article">
          <svg class="mh-search-panel__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input
            type="search"
            name="q"
            id="mh-search-input"
            class="mh-search-panel__input"
            placeholder="Search products, editorials…"
            autocomplete="off"
            aria-label="Search"
          >
          <button type="button" class="mh-search-panel__close" id="mh-search-close" aria-label="Close search">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l14 14M15 1L1 15"/></svg>
          </button>
        </form>
        <div class="mh-search-panel__results" id="mh-search-panel-results"></div>
      </div>
    </div>

  </header>

  <!-- SEARCH OVERLAY -->
  <div class="mh-search-overlay" id="mh-search-overlay"></div>

  <!-- MOBILE NAV DRAWER -->
  <div class="mh-mob-overlay" id="mh-mob-overlay" aria-hidden="true"></div>
  <nav class="mh-mob-nav" id="mh-mob-nav" aria-label="Mobile navigation" aria-hidden="true">

    <div class="mh-mob-nav__head">
      <a href="/" class="mh-mob-nav__logo" aria-label="MARAIS">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 218 30" height="16" fill="currentColor" aria-hidden="true">
          <path d="M0 2h5.2l7.1 15.6L19.4 2h5.2v26h-5V12.4l-6.3 13.8h-1.9L5.1 12.4V28H0V2z"/>
          <path d="M34 2h5.4L51 28h-5.4l-2.6-6.8H31.6L29 28h-5.3L34 2zm5.5 17-4.3-11.2L30.9 19h8.6z"/>
          <path d="M55 2h11.4c3.2 0 5.7.85 7.3 2.55 1.6 1.7 2.4 4 2.4 6.85 0 2.2-.5 4.05-1.5 5.55s-2.4 2.55-4.2 3.15L76.6 28H71l-5.7-9.3H60V28h-5V2zm5 14.1h5.9c1.7 0 3-.42 3.9-1.27.9-.84 1.35-2.07 1.35-3.68s-.45-2.83-1.35-3.66C68.9 6.66 67.6 6.25 65.9 6.25H60v9.85z"/>
          <path d="M87 2h5.4L104 28h-5.4l-2.6-6.8H84.6L82 28h-5.3L87 2zm5.5 17-4.3-11.2L83.9 19h8.6z"/>
          <path d="M109 2h5v26h-5V2z"/>
          <path d="M118.5 23.9l3.3-3.55c1 1.12 2.12 1.97 3.35 2.55 1.22.58 2.55.87 3.97.87 1.55 0 2.77-.34 3.66-1.01.9-.68 1.35-1.6 1.35-2.75 0-.95-.3-1.72-.9-2.3-.6-.58-1.72-1.07-3.35-1.47l-2.9-.72c-2.35-.58-4.1-1.52-5.25-2.82-1.15-1.3-1.72-2.93-1.72-4.88 0-1.6.38-3.01 1.14-4.23.77-1.22 1.86-2.17 3.28-2.85 1.42-.68 3.07-1.02 4.95-1.02 1.82 0 3.5.32 5.03.95 1.53.63 2.82 1.52 3.87 2.67l-3.12 3.42c-.87-.93-1.82-1.63-2.85-2.1-1.03-.47-2.17-.7-3.42-.7-1.38 0-2.47.32-3.27.95-.8.63-1.2 1.47-1.2 2.52 0 .88.28 1.6.85 2.15.57.55 1.52.98 2.85 1.3l2.9.72c2.52.63 4.42 1.6 5.7 2.92 1.28 1.32 1.92 3.05 1.92 5.18 0 1.67-.4 3.13-1.2 4.38-.8 1.25-1.95 2.22-3.45 2.9-1.5.68-3.25 1.02-5.25 1.02-2.1 0-4.02-.38-5.75-1.14-1.73-.76-3.17-1.85-4.32-3.26z"/>
        </svg>
      </a>
      <button class="mh-mob-nav__close" id="mh-mob-close" aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l16 16M17 1L1 17"/></svg>
      </button>
    </div>

    <!-- Gender toggle -->
    <div class="mh-mob-gender">
      <button class="mh-mob-gender__btn js-mob-gender" data-g="women">Women</button>
      <button class="mh-mob-gender__btn js-mob-gender" data-g="men">Men</button>
    </div>

    <!-- Women nav -->
    <div class="mh-mob-nav__section" data-g="women">
      {%- for link in linklists['womens-menu'].links -%}
        {%- assign link_lower = link.title | downcase -%}
        {%- assign is_highlight = false -%}
        {%- if link_lower contains 'sale' or link_lower contains 'new arrivals' -%}
          {%- assign is_highlight = true -%}
        {%- endif -%}
        {%- if link.links.size > 0 -%}
          <details class="mh-mob-nav__group">
            <summary class="mh-mob-nav__group-title">{{ link.title }} <svg class="mh-mob-nav__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4l4 4 4-4"/></svg></summary>
            <div class="mh-mob-nav__sub">
              {%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" class="{% if is_highlight %}mh-mob-nav__highlight{% else %}mh-mob-nav__link{% endif %}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Men nav -->
    <div class="mh-mob-nav__section mh-mob-nav__section--hidden" data-g="men">
      {%- for link in linklists['mens-menu'].links -%}
        {%- assign link_lower = link.title | downcase -%}
        {%- assign is_highlight = false -%}
        {%- if link_lower contains 'sale' or link_lower contains 'new arrivals' -%}
          {%- assign is_highlight = true -%}
        {%- endif -%}
        {%- if link.links.size > 0 -%}
          <details class="mh-mob-nav__group">
            <summary class="mh-mob-nav__group-title">{{ link.title }} <svg class="mh-mob-nav__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4l4 4 4-4"/></svg></summary>
            <div class="mh-mob-nav__sub">
              {%- for child in link.links -%}<a href="{{ child.url }}">{{ child.title }}</a>{%- endfor -%}
            </div>
          </details>
        {%- else -%}
          <a href="{{ link.url }}" class="{% if is_highlight %}mh-mob-nav__highlight{% else %}mh-mob-nav__link{% endif %}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Bottom icons row -->
    <div class="mh-mob-nav__foot">
      <button class="mh-mob-nav__foot-btn" id="mh-mob-search-trigger" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <span>Search</span>
      </button>
      <a href="/account" class="mh-mob-nav__foot-btn" aria-label="Account">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span>Account</span>
      </a>
      <button class="mh-mob-nav__foot-btn mh-mob-cart-trigger" aria-label="Cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <span>Cart {%- if cart.item_count > 0 -%}({{ cart.item_count }}){%- endif -%}</span>
      </button>
    </div>

  </nav>

  <script>
  (function () {
    var burger   = document.querySelector('.mh-burger');
    var closeBtn = document.getElementById('mh-mob-close');
    var overlay  = document.getElementById('mh-mob-overlay');
    var nav      = document.getElementById('mh-mob-nav');

    function openNav() {
      nav.classList.add('is-open');
      overlay.classList.add('is-visible');
      nav.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');
      burger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeNav() {
      nav.classList.remove('is-open');
      overlay.classList.remove('is-visible');
      nav.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      burger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    burger.addEventListener('click', openNav);
    closeBtn.addEventListener('click', closeNav);
    overlay.addEventListener('click', closeNav);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeNav(); });

    /* Mobile gender toggle */
    var stored = localStorage.getItem('mh-gender') || 'women';
    setMob(stored);
    document.querySelectorAll('.js-mob-gender').forEach(function (btn) {
      btn.addEventListener('click', function () {
        setMob(this.dataset.g);
        localStorage.setItem('mh-gender', this.dataset.g);
      });
    });
    function setMob(g) {
      document.querySelectorAll('.js-mob-gender').forEach(function (b) { b.classList.toggle('mh-mob-gender__btn--active', b.dataset.g === g); });
      document.querySelectorAll('.mh-mob-nav__section').forEach(function (s) { s.classList.toggle('mh-mob-nav__section--hidden', s.dataset.g !== g); });
    }
  }());
  </script>

  <!-- MINI CART DRAWER -->
  <div class="mh-cart-overlay" id="mh-cart-overlay" aria-hidden="true"></div>
  <div class="mh-cart-drawer" id="mh-cart-drawer" aria-label="Shopping cart" aria-hidden="true">
    <div class="mh-cart-drawer__head">
      <span class="mh-cart-drawer__title">Your Bag <span id="mh-cart-drawer-count">{%- if cart.item_count > 0 -%}({{ cart.item_count }}){%- endif -%}</span></span>
      <button class="mh-cart-drawer__close" id="mh-cart-drawer-close" aria-label="Close cart">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l14 14M15 1L1 15"/></svg>
      </button>
    </div>

    <div class="mh-cart-drawer__body" id="mh-cart-drawer-body">
      {%- if cart.item_count == 0 -%}
        <div class="mh-cart-drawer__empty">
          <p>Your bag is empty.</p>
          <a href="/collections/all" class="mh-btn">Start Shopping</a>
        </div>
      {%- else -%}
        <ul class="mh-cart-drawer__items">
          {%- for item in cart.items -%}
            <li class="mh-cart-drawer__item" data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="mh-cart-drawer__item-img">
                {%- if item.image -%}
                  <img src="{{ item.image | img_url: '160x200', crop: 'center' }}" alt="{{ item.image.alt | escape | default: item.title }}" width="80" height="100" loading="lazy">
                {%- endif -%}
              </a>
              <div class="mh-cart-drawer__item-info">
                <p class="mh-cart-drawer__item-vendor">{{ item.vendor }}</p>
                <a href="{{ item.url }}" class="mh-cart-drawer__item-title">{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p class="mh-cart-drawer__item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <div class="mh-cart-drawer__item-foot">
                  <div class="mh-cart-drawer__qty">
                    <button class="mh-cart-drawer__qty-btn" data-dir="down" aria-label="Decrease quantity">−</button>
                    <span class="mh-cart-drawer__qty-val">{{ item.quantity }}</span>
                    <button class="mh-cart-drawer__qty-btn" data-dir="up" aria-label="Increase quantity">+</button>
                  </div>
                  <span class="mh-cart-drawer__item-price">{{ item.line_price | money }}</span>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="mh-cart-drawer__foot" id="mh-cart-drawer-foot">
      {%- if cart.item_count > 0 -%}
        <div class="mh-cart-drawer__subtotal">
          <span>Subtotal</span>
          <span id="mh-cart-drawer-subtotal">{{ cart.total_price | money }}</span>
        </div>
        <p class="mh-cart-drawer__note">Shipping &amp; taxes calculated at checkout</p>
        <a href="/cart" class="mh-btn mh-btn--outline mh-cart-drawer__view">View Full Cart</a>
        <a href="/checkout" class="mh-btn mh-cart-drawer__checkout">Checkout</a>
      {%- endif -%}
    </div>
  </div>

