        <p class="mh-cart-drawer__note">Shipping &amp; taxes calculated at checkout</p>
        <a href="/cart" class="mh-btn mh-btn--outline mh-cart-drawer__view">View Full Cart</a>
        <a href="/checkout" class="mh-btn mh-cart-drawer__checkout">Checkout</a>
      {%- endif -%}
    </div>
  </div>

