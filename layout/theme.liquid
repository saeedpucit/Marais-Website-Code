  <!-- MINI CART JS -->
  <script>
  (function () {
    var trigger    = document.getElementById('mh-cart-trigger');
    var mobTrigger = document.querySelector('.mh-mob-cart-trigger');
    var drawer     = document.getElementById('mh-cart-drawer');
    var overlay    = document.getElementById('mh-cart-overlay');
    var closeBtn   = document.getElementById('mh-cart-drawer-close');
    var badge      = document.getElementById('mh-cart-badge');

    function esc(s) {
      return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function fmt(cents) {
      return new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' }).format(cents / 100);
    }
    function sizedImg(url) {
      return url.replace(/(\.(jpg|jpeg|png|gif|webp))(\?.*)?$/i, '_160x200_crop_center$1');
    }

    function openCart() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-visible');
      drawer.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');
      if (trigger) trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeCart() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-visible');
      drawer.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    function refreshDrawer(thenOpen) {
      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          var count = cart.item_count;

          /* Badge */
          if (badge) { badge.textContent = count; badge.style.display = count > 0 ? '' : 'none'; }

          /* Drawer count label */
          var countEl = document.getElementById('mh-cart-drawer-count');
          if (countEl) countEl.textContent = count > 0 ? '(' + count + ')' : '';

          /* Body */
          var bodyEl = document.getElementById('mh-cart-drawer-body');
          if (bodyEl) {
            if (count === 0) {
              bodyEl.innerHTML = '<div class="mh-cart-drawer__empty"><p>Your bag is empty.</p><a href="/collections/all" class="mh-btn">Start Shopping</a></div>';
            } else {
              var html = '<ul class="mh-cart-drawer__items">';
              cart.items.forEach(function (item) {
                var img = item.image ? '<img src="' + sizedImg(item.image) + '" alt="" width="80" height="100" loading="lazy">' : '';
                var variant = item.variant_title && item.variant_title !== 'Default Title'
                  ? '<p class="mh-cart-drawer__item-variant">' + esc(item.variant_title) + '</p>' : '';
                html += '<li class="mh-cart-drawer__item" data-key="' + esc(item.key) + '">'
                  + '<a href="' + esc(item.url) + '" class="mh-cart-drawer__item-img">' + img + '</a>'
                  + '<div class="mh-cart-drawer__item-info">'
                  + '<p class="mh-cart-drawer__item-vendor">' + esc(item.vendor) + '</p>'
                  + '<a href="' + esc(item.url) + '" class="mh-cart-drawer__item-title">' + esc(item.product_title) + '</a>'
                  + variant
                  + '<div class="mh-cart-drawer__item-foot">'
                  + '<div class="mh-cart-drawer__qty">'
                  + '<button class="mh-cart-drawer__qty-btn" data-dir="down" aria-label="Decrease quantity">−</button>'
                  + '<span class="mh-cart-drawer__qty-val">' + item.quantity + '</span>'
                  + '<button class="mh-cart-drawer__qty-btn" data-dir="up" aria-label="Increase quantity">+</button>'
                  + '</div>'
                  + '<span class="mh-cart-drawer__item-price">' + fmt(item.line_price) + '</span>'
                  + '</div></div></li>';
              });
              html += '</ul>';
              bodyEl.innerHTML = html;
            }
          }

          /* Footer */
          var footEl = document.getElementById('mh-cart-drawer-foot');
          if (footEl) {
            footEl.innerHTML = count > 0
              ? '<div class="mh-cart-drawer__subtotal"><span>Subtotal</span><span id="mh-cart-drawer-subtotal">' + fmt(cart.total_price) + '</span></div>'
                + '<p class="mh-cart-drawer__note">Shipping &amp; taxes calculated at checkout</p>'
                + '<a href="/cart" class="mh-btn mh-btn--outline mh-cart-drawer__view">View Full Cart</a>'
                + '<a href="/checkout" class="mh-btn mh-cart-drawer__checkout">Checkout</a>'
              : '';
          }

          if (thenOpen) openCart();
        });
    }

    /* Expose globally so collection/search JS can trigger */
    window.MaraisCart = { open: openCart, close: closeCart, refresh: refreshDrawer };

    if (trigger) trigger.addEventListener('click', openCart);
    if (mobTrigger) mobTrigger.addEventListener('click', function () {
      document.getElementById('mh-mob-nav') && document.getElementById('mh-mob-nav').classList.remove('is-open');
      document.getElementById('mh-mob-overlay') && document.getElementById('mh-mob-overlay').classList.remove('is-visible');
      document.body.style.overflow = '';
      openCart();
    });
    if (closeBtn) closeBtn.addEventListener('click', closeCart);
    if (overlay) overlay.addEventListener('click', closeCart);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeCart(); });

    /* Qty controls — delegated on body so rebuilt HTML works */
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.mh-cart-drawer__qty-btn');
      if (!btn) return;
      var item  = btn.closest('.mh-cart-drawer__item');
      var key   = item && item.dataset.key;
      var valEl = item && item.querySelector('.mh-cart-drawer__qty-val');
      if (!key || !valEl) return;
      var current = parseInt(valEl.textContent, 10) || 1;
      var next = btn.dataset.dir === 'up' ? current + 1 : Math.max(0, current - 1);
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: next })
      })
      .then(function (r) { return r.json(); })
      .then(function () { refreshDrawer(false); });
    });
  }());
  </script>

  <!-- BACK TO TOP -->
  <button class="mh-back-top" id="mh-back-top" aria-label="Back to top">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 13V3M3 8l5-5 5 5"/></svg>
  </button>
  <script>
  (function () {
    var btn = document.getElementById('mh-back-top');
    window.addEventListener('scroll', function () {
      btn.classList.toggle('is-visible', window.scrollY > 400);
    }, { passive: true });
    btn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  }());
  </script>
</body>
</html>
