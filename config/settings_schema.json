  {
    "name": "Free Shipping",
    "settings": [
      {
        "type": "header",
        "content": "Free Shipping Threshold"
      },
      {
        "type": "paragraph",
        "content": "Configure free shipping threshold and messaging. The progress bar will automatically show customer progress toward free shipping."
      },
      {
        "type": "checkbox",
        "id": "enable_free_shipping",
        "label": "Enable Free Shipping Progress Bar",
        "default": false
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold Amount",
        "default": 200,
        "info": "Enter the amount in dollars (e.g., 200 for $200.00)"
      },
      {
        "type": "text",
        "id": "free_shipping_remaining_message",
        "label": "Remaining Amount Message",
        "default": "You're $X away from **free shipping**",
        "info": "Use $X as a placeholder for the remaining amount. The $X will be automatically replaced with the actual remaining amount needed to unlock free shipping."
      },
      {
        "type": "text",
        "id": "free_shipping_unlocked_message",
        "label": "Free Shipping Unlocked Message",
        "default": "You've unlocked **free shipping**"
      }
    ]
  },
